# ============================================================
# PhishGuard Backend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# MongoDB Atlas URI (get from atlas.mongodb.com)
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/phishguard?retryWrites=true&w=majority

DB_NAME=phishguard

# JWT Secret - generate a random 64-char string
JWT_SECRET=replace_with_a_long_random_string_minimum_32_chars

ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Gmail SMTP (for OTP and reset password emails)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx   # Gmail App Password (NOT your normal password)
